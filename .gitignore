# ============================================================================
# Data-store safety: this repo is designed to sit AT THE ROOT of a real data
# tree (node folders full of sensor data live beside Code/). Ignore
# everything by default and allowlist only code, docs and the
# ProjectBuilder-maintained metadata files, so `git add -A` can never stage
# collected data. Same pattern as the APPN-42 master repo.
# ============================================================================
*.*

# ---- repo plumbing + top-level code/docs ----
!.gitignore
!.gitattributes
!*.py
!*.sh
!*.md
!/FolderStructureInfo.txt
!/NodeSummary.yaml
!/environment.yml

# ---- data-tree depth rules ----
# Ignore FILES at every depth inside top-level folders (this also catches
# extension-less sensor files that *.* cannot match), while re-including
# the DIRECTORIES so git can keep walking to the metadata files below.
# Depth 7+ (tier folders and deeper) is pruned entirely.
/*/*
!/*/*/
/*/*/*
!/*/*/*/
/*/*/*/*
!/*/*/*/*/
/*/*/*/*/*
!/*/*/*/*/*/
/*/*/*/*/*/*
!/*/*/*/*/*/*/
/*/*/*/*/*/*/*

# ---- re-includes (must come after the depth rules) ----
!.github/
!.github/**
!Code/**
!reference/**
!*FieldLog.csv
!*ProjectsSummary.csv
!*RunOverview.csv
!*ProjectSummary.yaml
!*_Issues.yaml
!*/DM01_AdoptionReport.md
!*/**/Documentation/**/README.md

# ============================================================================
# Ignores for extension-less / directory entries
# ============================================================================
__pycache__/
.vscode/
.idea/
build/
dist/
venv/
env/
ENV/
.venv
.ipynb_checkpoints
QC_Spectral_Tables/

