# ============================================================================
# Data-store safety: this repo is designed to sit AT THE ROOT of a real data
# tree (node folders full of sensor data live beside Code/). Ignore
# everything by default and allowlist only code, docs and the
# ProjectBuilder-maintained metadata files, so `git add -A` can never stage
# collected data. Same pattern as the APPN-42 master repo.
# ============================================================================
*.*

# ---- repo plumbing ----
!.gitignore
!.gitattributes
!.github/
!.github/**

# ---- code + docs (any depth) ----
!*.py
!*.sh
!*.md

# ---- repo-shipped reference + template files ----
!Code/**
!reference/**
!/FolderStructureInfo.txt
!/NodeSummary.yaml

# ---- ProjectBuilder-maintained metadata (any depth) ----
!*FieldLog.csv
!*ProjectsSummary.csv
!*RunOverview.csv
!*ProjectSummary.yaml
!*_Issues.yaml

# ============================================================================
# Ignores for extension-less / directory entries (*.* cannot catch these)
# ============================================================================
__pycache__/
.vscode/
.idea/
build/
dist/
venv/
env/
ENV/
.venv
.ipynb_checkpoints
QC_Spectral_Tables/

